// ui.c - UI process
// Build: gcc -Wall -Wextra -std=c11 -o ui ui.c -lrt
// Uses POSIX message queues to communicate with the Core process.

#include <stdio.h>
#include <string.h>
#include <mqueue.h>
#include "ipc.h"

static mqd_t q_to_core = (mqd_t)-1;
static mqd_t q_from_core = (mqd_t)-1;

static CmdType parse_cmd(const char *s) {
    if (!strcmp(s, "load"))  return CMD_LOAD;
    if (!strcmp(s, "run"))   return CMD_RUN;
    if (!strcmp(s, "step"))  return CMD_STEP;
    if (!strcmp(s, "reg"))   return CMD_REG;
    if (!strcmp(s, "mem"))   return CMD_MEM;
    if (!strcmp(s, "stack")) return CMD_STACK;
    if (!strcmp(s, "queue")) return CMD_QUEUE;
    if (!strcmp(s, "reset")) return CMD_RESET;
    if (!strcmp(s, "quit"))  return CMD_QUIT;
    return CMD_UNKNOWN;
}

static void print_help(void) {
    puts("Commands:\n"
         "  load <file>   Load integer values from a file\n"
         "  run           Run the loaded program\n"
         "  step          Execute one value\n"
         "  reg           Show CPU registers\n"
         "  mem <addr>    Show a memory location\n"
         "  stack         Show stack status\n"
         "  queue         Show queue status\n"
         "  reset         Reset simulator\n"
         "  quit          Exit simulator\n"
         "  help          Show this help\n");
}

static int ipc_send(const Message *m) {
    if (mq_send(q_to_core, (const char *)m, sizeof(*m), 0) == -1) {
        perror("UI: mq_send");
        return -1;
    }
    return 0;
}

static int ipc_recv(Reply *reply) {
    if (mq_receive(q_from_core, (char *)reply, sizeof(*reply), NULL) == -1) {
        perror("UI: mq_receive");
        return -1;
    }
    return 0;
}

int main(void) {
    q_to_core = mq_open(Q_UI_TO_CORE, O_WRONLY);
    if (q_to_core == (mqd_t)-1) {
        perror("UI: open UI->Core queue");
        puts("Start the Core process first.");
        return 1;
    }

    q_from_core = mq_open(Q_CORE_TO_UI, O_RDONLY);
    if (q_from_core == (mqd_t)-1) {
        perror("UI: open Core->UI queue");
        mq_close(q_to_core);
        return 1;
    }

    puts("Simulator UI started. Type 'help' for commands.");

    for (;;) {
        char line[256];
        char cmd[32] = "";
        char arg[MAX_ARG] = "";

        printf("sim> ");
        fflush(stdout);

        if (!fgets(line, sizeof(line), stdin))
            break;

        int n = sscanf(line, "%31s %127[^\n]", cmd, arg);
        if (n < 1)
            continue;

        if (!strcmp(cmd, "help")) {
            print_help();
            continue;
        }

        Message m = {0};
        m.type = parse_cmd(cmd);

        if (n == 2)
            snprintf(m.arg, sizeof(m.arg), "%s", arg);

        if (m.type == CMD_UNKNOWN) {
            puts("Unknown command. Type 'help'.");
            continue;
        }

        if (ipc_send(&m) == -1)
            break;

        /* QUIT also receives Core's final reply before UI exits. */
        Reply reply;
        if (ipc_recv(&reply) == -1)
            break;

        printf("%s\n", reply.text);

        if (m.type == CMD_QUIT)
            break;
    }

    mq_close(q_to_core);
    mq_close(q_from_core);

    puts("UI process terminated.");
    return 0;
}
